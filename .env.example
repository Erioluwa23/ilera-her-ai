# N-ATLAS text LLM endpoint. Use an OpenAI-compatible /v1/chat/completions endpoint
# backed by the official gated NCAIR1/N-ATLaS model.
NATLAS_LLM_API_URL=
NATLAS_LLM_API_KEY=
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS

# Telephony provider credentials for IVR recording retrieval
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Hugging Face gated-model access. Any one of these names is accepted by the runtime.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_TOKEN=

# ASR uses the fixed ÌleraHer Gradio runtime in code: Kolade1/ileraHer-natlas-runtime.
# No NATLAS_ASR_SPACE / NATLAS_HF_SPACE variable is required on Render.

# Optional separate ÌleraHer-owned Space for the official NCAIR1/N-ATLaS text model.
NATLAS_HF_LLM_SPACE=

# Ordinary-phone IVR. Set secrets only in server settings, never in NEXT_PUBLIC variables.
IVR_ENABLED=false

# Optional downloadable voice-chat replies. No alternate ASR/LLM is used.
# HTTPS POST {text, language} -> audio/mpeg or audio/wav, at most 4 MiB.
VOICE_TTS_API_URL=
VOICE_TTS_API_KEY=
VOICE_TTS_LANGUAGES=
IVR_PUBLIC_BASE_URL=https://ilera-her-ai.onrender.com
# Voice-capable number owned by your Twilio account; E.164 format.
IVR_PHONE_NUMBER=
# Random secret of at least 32 characters. Signs call state and encrypts temporary responses.
IVR_SESSION_SECRET=
# Optional separate IVR PostgreSQL connection; defaults to DATABASE_URL.
# Prefer Render's internal URL.
IVR_DATABASE_URL=
# HTTPS directory of native-speaker-reviewed prerecorded prompts: <base>/<yo|ha|ig>/<name>.mp3
# Required names: consent, record, waiting, menu, error, goodbye.
IVR_PROMPT_BASE_URL=
# External HTTPS TTS endpoint: POST {text,language} -> audio/mpeg or audio/wav bytes.
IVR_TTS_API_URL=
IVR_TTS_API_KEY=
# Only list languages whose prompts and TTS have been tested. English uses Twilio en-GB playback.
IVR_TTS_LANGUAGES=

# Separate long-lived random secret (32+ characters) for hashed caller IDs and encrypted history.
# Keep stable across deployments. Changing it makes saved profiles inaccessible.
IVR_PROFILE_SECRET=
# Reviewed native-language history prompts available (yo,ha,ig); English is built in.
IVR_HISTORY_PROMPT_LANGUAGES=
# Optional secret for the scheduled retention cleanup endpoint, 32+ characters.
IVR_MAINTENANCE_SECRET=

# Comma-separated E.164 phone numbers allowed to open /admin
ADMIN_PHONE_NUMBERS=

# Default explanation generation. All keys remain server-side.
AI_PROVIDER_MODE=groq-openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
AI_EXPLANATION_TOTAL_TIMEOUT_MS=25000
AI_GROQ_TIMEOUT_MS=10000
AI_OPENAI_TIMEOUT_MS=12000
# AI_PROVIDER_MODE=natlas explicitly enables the preserved N-ATLAS demonstration path.
# Clinical policies are source-controlled review records; environment flags cannot bypass sign-off.

# Phone explanations require a separate processing/retention review before enablement.
IVR_EXTERNAL_AI_ENABLED=false
