# Private cycle records use the existing PostgreSQL DATABASE_URL.
# Server only: 32 random bytes encoded as base64. Keep this key stable and backed up.
# Never put it in NEXT_PUBLIC_* variables or commit a real value.
CYCLE_DATA_ENCRYPTION_KEY=

# N-ATLAS text LLM endpoint. Use an OpenAI-compatible /v1/chat/completions endpoint
# backed by the official gated NCAIR1/N-ATLaS model.
NATLAS_LLM_API_URL=
NATLAS_LLM_API_KEY=
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS

# Telephony provider credentials for IVR recording retrieval
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Hugging Face gated-model access. Any one of these names is accepted by the runtime.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_TOKEN=

# ASR uses the fixed ÌleraHer Gradio runtime in code: Kolade1/ileraHer-natlas-runtime.
# No NATLAS_ASR_SPACE / NATLAS_HF_SPACE variable is required on Render.

# Optional separate ÌleraHer-owned Space for the official NCAIR1/N-ATLaS text model.
NATLAS_HF_LLM_SPACE=

# Ordinary-phone IVR. Set secrets only in server settings, never in NEXT_PUBLIC variables.
IVR_ENABLED=false
# Publish only after actual basic-phone calls pass acceptance for the enabled languages.
IVR_PHONE_VERIFIED=false

# Voice chat and cycle-insight speech use YarnGPT2b in the existing owned runtime.
# No separate TTS endpoint or device speech fallback is used.
IVR_PUBLIC_BASE_URL=https://ilera-her-ai.onrender.com
# Voice-capable number owned by your Twilio account; E.164 format.
IVR_PHONE_NUMBER=
# Random secret of at least 32 characters. Signs call state and encrypts temporary responses.
IVR_SESSION_SECRET=
# Optional separate IVR PostgreSQL connection; defaults to DATABASE_URL.
# Prefer Render's internal URL.
IVR_DATABASE_URL=
# HTTPS directory of prerecorded YarnGPT menu WAVs and manifest.json.
# Generate with scripts/prepare-ivr-prompts.mjs, review each language, then host the pack.
# For assets deployed under public/audio/ivr use https://ilera-her-ai.onrender.com/audio/ivr/
IVR_PROMPT_BASE_URL=
# Health replies use verified YarnGPT2b in the existing runtime for every language.
IVR_LANGUAGES=en-NG,yo,ha,ig

# Separate long-lived random secret (32+ characters) for hashed caller IDs and encrypted history.
# Keep stable across deployments. Changing it makes saved profiles inaccessible.
IVR_PROFILE_SECRET=
# Optional reviewed native-language history prompt packs (yo,ha,ig). English history
# prompts are included in the generator; native history remains disabled by default.
IVR_HISTORY_PROMPT_LANGUAGES=
# Optional secret for the scheduled retention cleanup endpoint, 32+ characters.
IVR_MAINTENANCE_SECRET=

# Comma-separated E.164 phone numbers allowed to open /admin
ADMIN_PHONE_NUMBERS=

# Separate SIM pilot API adapter. Generate secrets on the deployment host; never NEXT_PUBLIC.
# Keep disabled until the gateway, registered-user call and all enabled languages pass acceptance.
PHONE_INTEGRATION_KEY=
SIM_PHONE_ENABLED=false
SIM_PHONE_NUMBER=
# Set true only after a real inbound SIM call has been verified; a heartbeat alone is insufficient.
SIM_PHONE_VERIFIED=false
