# N-ATLAS speech recognition endpoint (optional)
NATLAS_ASR_API_URL=
NATLAS_ASR_API_KEY=

# N-ATLAS text LLM endpoint. Use an OpenAI-compatible /v1/chat/completions endpoint
# backed by the official gated NCAIR1/N-ATLaS model.
NATLAS_LLM_API_URL=
NATLAS_LLM_API_KEY=
NATLAS_LLM_MODEL=NCAIR1/N-ATLaS

# Legacy ASR names retained for backwards compatibility
NATLAS_API_URL=
NATLAS_API_KEY=

# Optional per-language N-ATLAS ASR endpoints. When set, these override NATLAS_ASR_API_URL.
NATLAS_ASR_EN_NG_URL=
NATLAS_ASR_YO_URL=
NATLAS_ASR_HA_URL=
NATLAS_ASR_IG_URL=

# Telephony provider credentials for IVR recording retrieval
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Hugging Face gated-model access. Any one of these names is accepted by the runtime.
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_TOKEN=

# Hugging Face Space mode.
# Point NATLAS_HF_SPACE to the ÌleraHer-owned Gradio/ZeroGPU runtime that exposes /transcribe.
NATLAS_HF_SPACE=

# Optional separate ÌleraHer-owned Space for the official NCAIR1/N-ATLaS text model.
NATLAS_HF_LLM_SPACE=
