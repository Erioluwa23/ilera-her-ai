# Install as /etc/ileraher-sim-call.env, owner root:asterisk, mode 0640.
ILERAHER_APP_URL=https://ilera-her-ai.onrender.com
# Same random secret as PHONE_INTEGRATION_KEY in the app's server environment.
PHONE_INTEGRATION_KEY=
# Different random secret; used by local FastAGI/API only.
SIM_API_KEY=
SIM_MEDIA_DIR=/var/lib/ileraher/media
SIM_PROMPTS_DIR=/opt/ileraher/prompts
# Add yo,ha,ig only after reviewing native-language prompts and actual phone replies.
SIM_REVIEWED_LANGUAGES=en-NG
SIM_FASTAGI_ENABLED=true
SIM_HEARTBEAT_ENABLED=true
